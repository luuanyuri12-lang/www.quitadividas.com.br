generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  nome               String?
  telefone           String?
  rendaMensal        Float             @default(0)
  plano              Plano             @default(ESSENCIAL)
  createdAt          DateTime          @default(now())
  dividas            Divida[]
  entradas           EntradaReceita[]
  diario             DiarioProposito[]
  gastos             Gasto[]
  codigoIndicacao    String?             @unique
  indicadoPorId      String?
  indicacoesFeitas   Indicacao[]         @relation("Indicacoes")
  foiIndicadoPor     Indicacao?          @relation("FoiIndicadoPor")
  comissoes          Comissao[]
  saques             SaqueRequest[]
  contasEmpresariais ContaEmpresarial[]
}

enum Plano {
  ESSENCIAL
  PRO
  ELITE
}

model Divida {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  nome           String
  tipo           String
  valorTotal     Float
  parcela        Float
  taxaMensal     Float
  mesesRestantes Int
  prioridade     Prioridade   @default(MEDIA)
  status         StatusDivida @default(ATIVA)
  createdAt      DateTime     @default(now())
  pagamentos     Pagamento[]
}

model Pagamento {
  id          String   @id @default(cuid())
  dividaId    String
  divida      Divida   @relation(fields: [dividaId], references: [id], onDelete: Cascade)
  valor       Float
  data        DateTime @default(now())
  comprovante String?
  createdAt   DateTime @default(now())
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum StatusDivida {
  ATIVA
  RENEGOCIADA
  QUITADA
}

model EntradaReceita {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  descricao String
  valor     Float
  tipo      String
  createdAt DateTime @default(now())
}

model DiarioProposito {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reflexao  String
  semana    Int
  createdAt DateTime @default(now())
}

model Gasto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  descricao String
  valor     Float
  categoria String
  createdAt DateTime @default(now())
}

model Indicacao {
  id          String   @id @default(cuid())
  indicadorId String
  indicador   User     @relation("Indicacoes", fields: [indicadorId], references: [id])
  indicadoId  String   @unique
  indicado    User     @relation("FoiIndicadoPor", fields: [indicadoId], references: [id])
  nivel       Int
  createdAt   DateTime @default(now())
}

model Comissao {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  valor     Float
  nivel     Int
  origem    String
  status    StatusComissao @default(PENDENTE)
  createdAt DateTime       @default(now())
}

enum StatusComissao {
  PENDENTE
  DISPONIVEL
  SOLICITADO
  PAGO
}

model SaqueRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  valor     Float
  pixKey    String
  status    String   @default("pendente")
  createdAt DateTime @default(now())
}

model ContaEmpresarial {
  id          String                   @id @default(cuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id])
  nome        String
  cnpj        String?
  setor       String?
  createdAt   DateTime                 @default(now())
  lancamentos LancamentoEmpresarial[]
}

model LancamentoEmpresarial {
  id        String           @id @default(cuid())
  contaId   String
  conta     ContaEmpresarial @relation(fields: [contaId], references: [id], onDelete: Cascade)
  descricao String
  valor     Float
  tipo      String
  categoria String
  data      DateTime         @default(now())
  createdAt DateTime         @default(now())
}
